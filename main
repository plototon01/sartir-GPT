import os
import numpy as np
import tensorflow as tf
from tensorflow.keras import layers
from tensorflow.keras import mixed_precision
from datasets import load_dataset
from transformers import AutoTokenizer

# --------------------------------------------------
# 0. ОПТИМИЗАЦИЯ ПОД GPU (MIXED PRECISION FP16)
# --------------------------------------------------
policy = mixed_precision.Policy('mixed_float16')
mixed_precision.set_global_policy(policy)

tf.random.set_seed(42)
np.random.seed(42)

# ==========================================
# 1. КОНФИГУРАЦИЯ С КОНТЕКСТОМ 1024
# ==========================================
MODEL_NAME = "ai-forever/rugpt3small_based_on_gpt2"

EMBED_DIM = 768
NUM_HEADS = 8
NUM_LAYERS = 8
MAX_SEQ_LEN = 1024  # Контекст 1024 токенов
BATCH_SIZE = 4      # Оптимальный батч под 12 GB VRAM
EPOCHS = 1
CHECKPOINT_DIR = "./checkpoints_1024"

print("1. Загрузка токенизатора...")
tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)
if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token

VOCAB_SIZE = tokenizer.vocab_size

# ==========================================
# 2. БЕЗОПАСНАЯ ЗАГРУЗКА ДАТАСЕТОВ
# ==========================================
print("2. Загрузка датасетов...")

def safe_load_dataset(path, split="train"):
    try:
        ds = load_dataset(path, split=split)
        print(f"  [+] Успешно загружен: {path}")
        return ds
    except Exception as e:
        print(f"  [-] Ошибка загрузки {path}. Пропускаем этот датасет.")
        return []

ds_twix = safe_load_dataset("t-tech/T-Wix")
ds_ru_code = safe_load_dataset("IlyaGusev/ru_turbo_alpaca")
ds_code_alpaca = safe_load_dataset("iamtarun/python_code_instructions_18k_alpaca")
ds_code_evol = safe_load_dataset("nickrosh/Evol-Instruct-Code-80k")
ds_flytech_code = safe_load_dataset("flytech/python-code-dataset")
ds_code_feedback = safe_load_dataset("m-a-p/CodeFeedback-Filtered-Instruction")

def create_multi_source_dataset(batch_size=4):
    def gen():
        # 1. T-Wix
        for item in ds_twix:
            messages = item.get("messages", [])
            text_parts = []
            for msg in messages:
                role = msg.get("role", "")
                content = msg.get("content", "")
                if role == "user":
                    text_parts.append(f"Пользователь: {content}")
                elif role == "assistant":
                    text_parts.append(f"Ассистент: {content}")

            text = "\n".join(text_parts).strip()
            if len(text) >= 30:
                tokens = tokenizer(
                    text,
                    truncation=True,
                    max_length=MAX_SEQ_LEN + 1,
                    padding="max_length",
                    return_tensors="np"
                )["input_ids"][0]
                yield tokens[:-1], tokens[1:]

        # 2. IlyaGusev / Ru Turbo Alpaca
        for item in ds_ru_code:
            inst = item.get("instruction", "")
            inp = item.get("input", "")
            out = item.get("output", "")

            if len(out.strip()) >= 15:
                user_msg = f"{inst}\n{inp}".strip()
                text = f"Пользователь: {user_msg}\nАссистент:\n{out}"

                tokens = tokenizer(
                    text,
                    truncation=True,
                    max_length=MAX_SEQ_LEN + 1,
                    padding="max_length",
                    return_tensors="np"
                )["input_ids"][0]
                yield tokens[:-1], tokens[1:]

        # 3. FlyTech Python Code
        for item in ds_flytech_code:
            inst = item.get("instruction", "")
            out = item.get("output", "")

            if len(out.strip()) >= 20:
                text = f"Пользователь: Напиши код на Python:\n{inst}\nАссистент:\n```python\n{out}\n```"
                tokens = tokenizer(
                    text,
                    truncation=True,
                    max_length=MAX_SEQ_LEN + 1,
                    padding="max_length",
                    return_tensors="np"
                )["input_ids"][0]
                yield tokens[:-1], tokens[1:]

        # 4. CodeFeedback Filtered
        for item in ds_code_feedback:
            query = item.get("query", "")
            answer = item.get("answer", "")

            if len(answer.strip()) >= 20:
                text = f"Пользователь: {query}\nАссистент:\n{answer}"
                tokens = tokenizer(
                    text,
                    truncation=True,
                    max_length=MAX_SEQ_LEN + 1,
                    padding="max_length",
                    return_tensors="np"
                )["input_ids"][0]
                yield tokens[:-1], tokens[1:]

        # 5. Python Code Alpaca
        for item in ds_code_alpaca:
            inst = item.get("instruction", "")
            inp = item.get("input", "")
            out = item.get("output", "")

            if len(out.strip()) >= 15:
                user_msg = f"{inst}\n{inp}".strip()
                text = f"Пользователь: {user_msg}\nАссистент:\n```python\n{out}\n```"
                tokens = tokenizer(
                    text,
                    truncation=True,
                    max_length=MAX_SEQ_LEN + 1,
                    padding="max_length",
                    return_tensors="np"
                )["input_ids"][0]
                yield tokens[:-1], tokens[1:]

        # 6. Evol-Instruct-Code
        for item in ds_code_evol:
            inst = item.get("instruction", "")
            out = item.get("output", "")

            if len(out.strip()) >= 20:
                text = f"Пользователь: {inst}\nАссистент:\n{out}"
                tokens = tokenizer(
                    text,
                    truncation=True,
                    max_length=MAX_SEQ_LEN + 1,
                    padding="max_length",
                    return_tensors="np"
                )["input_ids"][0]
                yield tokens[:-1], tokens[1:]

    tf_dataset = tf.data.Dataset.from_generator(
        gen,
        output_signature=(
            tf.TensorSpec(shape=(MAX_SEQ_LEN,), dtype=tf.int32),
            tf.TensorSpec(shape=(MAX_SEQ_LEN,), dtype=tf.int32)
        )
    )

    tf_dataset = (
        tf_dataset
        .shuffle(buffer_size=2000)
        .batch(batch_size, drop_remainder=False)
        .prefetch(tf.data.AUTOTUNE)
    )
    return tf_dataset

train_dataset = create_multi_source_dataset(batch_size=BATCH_SIZE)

# ==========================================
# 3. АРХИТЕКТУРА С SWIGLU И RMSNORM
# ==========================================
class RMSNorm(layers.Layer):
    def __init__(self, dim, eps=1e-6, **kwargs):
        super().__init__(**kwargs)
        self.eps = eps
        self.scale = self.add_weight(name="scale", shape=(dim,), initializer="ones")

    def call(self, x):
        x_fp32 = tf.cast(x, tf.float32)
        variance = tf.reduce_mean(tf.square(x_fp32), axis=-1, keepdims=True)
        norm_x = x_fp32 * tf.math.rsqrt(variance + self.eps)
        return tf.cast(norm_x, x.dtype) * self.scale

class SwiGLUFFN(layers.Layer):
    def __init__(self, embed_dim, **kwargs):
        super().__init__(**kwargs)
        hidden_dim = int(embed_dim * 8 / 3)
        self.w1 = layers.Dense(hidden_dim)
        self.w2 = layers.Dense(hidden_dim)
        self.w3 = layers.Dense(embed_dim)

    def call(self, x):
        return self.w3(tf.nn.swish(self.w1(x)) * self.w2(x))

class PositionalEmbedding(layers.Layer):
    def __init__(self, max_seq_len, embed_dim, **kwargs):
        super().__init__(**kwargs)
        self.pos_emb = layers.Embedding(max_seq_len, embed_dim)

    def call(self, inputs):
        seq_len = tf.shape(inputs)[1]
        positions = tf.range(start=0, limit=seq_len, delta=1)
        return self.pos_emb(positions)

class LightTransformerBlock(layers.Layer):
    def __init__(self, embed_dim, num_heads, **kwargs):
        super().__init__(**kwargs)
        self.mha = layers.MultiHeadAttention(num_heads=num_heads, key_dim=embed_dim // num_heads)
        self.ffn = SwiGLUFFN(embed_dim)
        self.norm1 = RMSNorm(embed_dim)
        self.norm2 = RMSNorm(embed_dim)

    def call(self, x):
        seq_len = tf.shape(x)[1]
        causal_mask = tf.linalg.band_part(tf.ones((seq_len, seq_len)), -1, 0)

        norm_x = self.norm1(x)
        attn_out = self.mha(norm_x, norm_x, attention_mask=causal_mask)
        x = x + attn_out

        ffn_out = self.ffn(self.norm2(x))
        return x + ffn_out

def build_optimized_llm():
    inputs = layers.Input(shape=(None,), dtype=tf.int32, name="input_ids")

    token_embed = layers.Embedding(VOCAB_SIZE, EMBED_DIM)(inputs)
    pos_embed = PositionalEmbedding(MAX_SEQ_LEN, EMBED_DIM)(inputs)

    x = token_embed + pos_embed
    for _ in range(NUM_LAYERS):
        x = LightTransformerBlock(EMBED_DIM, NUM_HEADS)(x)

    x = RMSNorm(EMBED_DIM)(x)
    logits = layers.Dense(VOCAB_SIZE, dtype='float32', name="logits")(x)

    model = tf.keras.Model(inputs=inputs, outputs=logits)
    return model

# ==========================================
# 4. СБОРКА И ОБУЧЕНИЕ
# ==========================================
print("3. Сборка модели...")
model = build_optimized_llm()

total_steps = 40000
warmup_steps = 1000

lr_schedule = tf.keras.optimizers.schedules.CosineDecay(
    initial_learning_rate=3e-4,
    decay_steps=total_steps,
    warmup_target=3e-4,
    warmup_steps=warmup_steps,
    alpha=0.05
)

model.compile(
    optimizer=tf.keras.optimizers.AdamW(learning_rate=lr_schedule, weight_decay=0.01),
    loss=tf.keras.losses.SparseCategoricalCrossentropy(from_logits=True)
)

os.makedirs(CHECKPOINT_DIR, exist_ok=True)

# ИСПРАВЛЕНО: заменено {step:06d} на {batch:06d}
checkpoint_path = os.path.join(CHECKPOINT_DIR, "ckpt_batch_{batch:06d}.weights.h5")

checkpoint_callback = tf.keras.callbacks.ModelCheckpoint(
    filepath=checkpoint_path,
    save_weights_only=True,
    save_freq=1000,
    verbose=1
)

latest_ckpt = tf.train.latest_checkpoint(CHECKPOINT_DIR)
if latest_ckpt:
    print(f"Загрузка последнего чекпоинта: {latest_ckpt}")
    model.load_weights(latest_ckpt)

print("4. Старт обучения...")
model.fit(
    train_dataset,
    epochs=EPOCHS,
    callbacks=[checkpoint_callback]
)

# ==========================================
# 5. ЭКСПОРТ В TFLITE
# ==========================================
print("5. Экспорт Keras модели...")
saved_model_path = "optimized_llm_1024_export"
model.export(saved_model_path)

print("6. Конвертация в TFLite...")
converter = tf.lite.TFLiteConverter.from_saved_model(saved_model_path)
converter.optimizations = [tf.lite.Optimize.DEFAULT]
tflite_model_bytes = converter.convert()

tflite_path = "optimized_llm_1024.tflite"
with open(tflite_path, "wb") as f:
    f.write(tflite_model_bytes)

print(f"\nГотово! Модель сохранена в {tflite_path} ({len(tflite_model_bytes) / 1024 / 1024:.2f} МБ)")
